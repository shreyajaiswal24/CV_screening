# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# --- REQUIRED ---
# Free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- REQUIRED IF DEPLOYED ---
# Puts a login on the app. Without it, a hosted instance cannot send email -
# a public URL with no password would let anyone send mail from your account.
APP_PASSWORD=

# --- OPTIONAL: sending interview invitations ---
# For Gmail this must be an App Password (16 characters, no spaces), not your
# normal password. https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- OPTIONAL: Google Sheets export ---
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# --- OPTIONAL: tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
