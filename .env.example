# Copy this file to .env and fill in the values. Never commit .env.

# --- REQUIRED ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- OPTIONAL: Google Drive + Sheets integration ---
# Path to your service-account JSON key file.
# Share your CV folder and results sheet with the service account's email.
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# --- OPTIONAL: tracing / latency + cost observability ---
# Leave blank to disable. Get keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OPTIONAL: sending interview invitations ---
# Only needed if you set email.send_email: true in config.yaml.
# For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
